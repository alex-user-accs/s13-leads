# Copy to .env.local for local development. On the hosting provider, set these
# in its Environment Variables settings instead — never commit real values.

# Public URL of the site (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only secrets for the lead form (Telegram notifications)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional: Google Search Console "HTML tag" verification code (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
